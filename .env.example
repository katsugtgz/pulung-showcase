# Clerk authentication keys.
# Replace the placeholders below with real keys from your Clerk dashboard
# (https://dashboard.clerk.com). Never commit real secret keys to git.
# The publishable key is safe to expose in the browser; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
#
# Clerk route configuration. These match the Next.js App Router paths the
# scaffold uses: sign-in and sign-up live under src/app/(public)/. Override
# only if you move those routes. Fallback redirects send users to /dashboard
# (demo hub) after authentication — the landing header is static (ADR-002),
# so redirecting to / made a successful sign-in look like a no-op.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
#
# Clerk dashboard config for this demo (User Factors):
#   - Google OAuth + Email/password ONLY.
#   - NO SMS OTP (out of scope per PRD issue #1).
# Configure these in the Clerk dashboard, not via env vars.
